# Ushbu faylni .env nomi bilan nusxalang va qiymatlarni to'ldiring.
# .env hech qachon git'ga yoki boshqa odamga yuborilmasin (parol saqlanadi).

# --- Sayt ---
BASE_URL=https://inspektor.stat.uz
SITE_LANG=uz
# /uz/inspector/<ID>/reports manzilidagi raqam
INSPECTOR_ID=1
# "Tashkilotni o'zgartirish" sahifasida qaysi tashkilot tanlansin (STIR)
ORG_INN=2004740220

# --- Qaysi hisobotlar ---
# Hisobot shakli ID'lari (URL'dagi form_type=...). 685 = "Biznesni ro'yxatga olish"
FORM_TYPES=685
# "Tarmoq bo'yicha" filtri: agriculture (Qishloq xo'jaligi), industry (Sanoat),
# construction (Qurilish), trade (Savdo), services (Xizmatlar), bo'sh = Hammasi
SECTOR=agriculture
# "Tashkilot turi" filtri: farm (Fermer va dehqon xo'jaligi), commercial, noncommercial, other, bo'sh = Hammasi
OPF_GROUP=
# Qaysi tablar ko'rib chiqilsin: new (YANGI), mine (MENGA BIRIKTIRILGAN)
TABS=new

# --- Ish rejimi ---
# dry_run = faqat o'qiydi, tahlil qiladi va log yozadi, HECH NARSA BOSMAYDI
# live    = "Olish", "Qabul qilish", "Qaytarish" tugmalarini haqiqatda bosadi
ROBOT_MODE=dry_run
AUTO_ACCEPT=true
# Rad etishni avval dry_run loglarini ko'rib, ishonch hosil qilgandan keyin yoqing
AUTO_REJECT=false
# Qo'lda ko'rish kerak bo'lgan hisobotlarni o'zingizga olib, izoh qoralamasini yozib qo'yish
MANUAL_TAKE=false
# "Olish"dan keyin saytning o'z "Tekshirish" tugmasini bosish. Sayt ogohlantirish (⚠) chiqarsa,
# robot hisobotni avtomatik qabul qilmaydi - inspektorga qoldiradi.
CLICK_SITE_CHECK=true
# live rejimda har bir Qabul/Qaytarish oldidan terminalda "ha / yo'q" so'rash
CONFIRM_EACH=true
# Bir ishga tushirishda nechta hisobot ko'rilsin (0 = hammasi). Buyruqda: --limit 1
MAX_REPORTS=0
# Bir ishga tushirishda maksimal nechta qabul/rad amali bajarilsin
MAX_ACTIONS_PER_RUN=20
# Amallar orasidagi tasodifiy pauza (soniya) - inson tezligida ishlash uchun
DELAY_MIN=1.5
DELAY_MAX=4.0

# --- Brauzer ---
# msedge (o'rnatilgan Edge) yoki chromium (playwright install chromium)
BROWSER_CHANNEL=msedge
HEADLESS=false
TIMEOUT_MS=20000

# --- Avtomatik login (ixtiyoriy) ---
# Tavsiya: bo'sh qoldiring va "python main.py login" orqali bir marta qo'lda (OneID login/parol) kiring.
# OneID (id.egov.uz) SMS-kod yoki captcha so'rashi mumkin, shuning uchun avtomatik kirish ishonchsiz.
# Sessiya data/browser_profile papkasida saqlanadi.
AUTO_LOGIN=false
LOGIN_USERNAME=
LOGIN_PASSWORD=

# --- Izohlar ---
ACCEPT_TEXT=Tizim tomonidan avtomatik tekshirildi va qabul qilindi.
COMMENT_MAX_LEN=2000
# Saytning sariq ogohlantirishi ("...Ma'lumotlarni tekshiring" + respondent izohi) bo'lsa:
#   manual - robot hal qilmaydi, inspektorga qoldiradi (izohni inspektor baholaydi)
#   reject - robot hisobotni ogohlantirishlar ro'yxati bilan qaytaradi (AUTO_REJECT=true bo'lsa)
SITE_WARNING_ACTION=manual
# Yig'indilarni solishtirishda yaxlitlash uchun ruxsat etilgan farq (mln so'm)
SUM_TOLERANCE=0.1
